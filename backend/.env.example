# Paste your MongoDB Atlas connection string here.
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/placement-tracker?retryWrites=true&w=majority
MONGODB_URI=

# Port the API server runs on (Render sets this automatically in production)
PORT=5000

# Comma-separated list of allowed frontend origins (for CORS)
# Example: http://localhost:5173,https://your-frontend.onrender.com
CLIENT_ORIGIN=http://localhost:5173

